		cpu-map {
			cluster0 {
				core0 {
					cpu = <0xe>;
				};
				core1 {
					cpu = <0xf>;
				};
				core2 {
					cpu = <0x10>;
				};
				core3 {
					cpu = <0x11>;
				};
			};
			cluster1 {
				core0 {
