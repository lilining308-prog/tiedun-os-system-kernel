	soc {
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		ranges = <0x0 0x0 0x0 0xffffffff>;
		compatible = "simple-bus";
		qcom,gdsc@0x16b004 {
			compatible = "qcom,gdsc";
			regulator-name = "pcie_0_gdsc";
			reg = <0x16b004 0x4>;
			qcom,poll-cfg-gdscr;
			status = "ok";
			phandle = <0x267>;
		};
		qcom,gdsc@0x18d004 {
			compatible = "qcom,gdsc";
			regulator-name = "pcie_1_gdsc";
