/dts-v1/;

/ {
	#address-cells = <0x2>;
	#size-cells = <0x2>;
	model = "Xiaomi Technologies, Inc. Dipper new P1 v2 gb";
	compatible = "qcom,sdm845-mtp", "qcom,sdm845", "qcom,mtp";
	qcom,msm-id = <0x141 0x20000>;
	interrupt-parent = <0x1>;
	qcom,board-id = <0x34 0x0>;
	cpus {
		#address-cells = <0x2>;
		#size-cells = <0x0>;
		cpu@0 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x0 0x0>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			qcom,freq-domain = <0x2 0x0 0x4>;
			cache-size = <0x8000>;
			cpu-release-addr = <0x0 0x90000000>;
			qcom,lmh-dcvs = <0x3>;
			#cooling-cells = <0x2>;
			next-level-cache = <0x4>;
			phandle = <0xe>;
			l2-cache {
				compatible = "arm,arch-cache";
				cache-size = <0x20000>;
				cache-level = <0x2>;
				next-level-cache = <0x5>;
				phandle = <0x4>;
				l3-cache {
					compatible = "arm,arch-cache";
					cache-size = <0x200000>;
					cache-level = <0x3>;
					phandle = <0x5>;
				};
			};
			l1-icache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x12000>;
				phandle = <0x118>;
			};
			l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0xa000>;
				phandle = <0x120>;
			};
			l1-tlb {
				qcom,dump-size = <0x6000>;
				phandle = <0x12c>;
			};
		};
		cpu@100 {
			device_type = "cpu";
