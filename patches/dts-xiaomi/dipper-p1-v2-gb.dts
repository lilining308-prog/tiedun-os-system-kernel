		qcom,mdss_dsi_pll@ae94a00 {
			compatible = "qcom,mdss_dsi_pll_10nm";
			label = "MDSS DSI 0 PLL";
			cell-index = <0x0>;
			#clock-cells = <0x1>;
			reg = <0xae94a00 0x1e0 0xae94200 0x100 0xae94400 0x800 0xaf03000 0x8>;
			reg-names = "pll_base", "dynamic_pll_base", "phy_base", "gdsc_base";
			clocks = <0x1d 0x0>;
			clock-names = "iface_clk";
			clock-rate = <0x0>;
			qcom,dsi-pll-ssc-en;
			qcom,dsi-pll-ssc-mode = "down-spread";
			gdsc-supply = <0x16>;
			phandle = <0x2c3>;
			qcom,platform-supply-entries {
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				qcom,platform-supply-entry@0 {
					reg = <0x0>;
					qcom,supply-name = "gdsc";
					qcom,supply-min-voltage = <0x0>;
					qcom,supply-max-voltage = <0x0>;
					qcom,supply-enable-load = <0x0>;
					qcom,supply-disable-load = <0x0>;
				};
			};
		};
